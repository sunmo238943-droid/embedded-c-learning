[32m+[m[32m## 4. switch / case[m
[32m+[m
[32m+[m[32m学习了固定离散值的分支判断：[m
[32m+[m
[32m+[m[32m```c[m
[32m+[m[32mswitch (mode)[m
[32m+[m[32m{[m
[32m+[m[32m    case 1:[m
[32m+[m[32m        printf("Manual mode\n");[m
[32m+[m[32m        break;[m
[32m+[m
[32m+[m[32m    case 2:[m
[32m+[m[32m        printf("Automatic mode\n");[m
[32m+[m[32m        break;[m
[32m+[m
[32m+[m[32m    default:[m
[32m+[m[32m        printf("Invalid mode\n");[m
[32m+[m[32m}[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m理解了：[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32mcase     → 匹配具体值[m
[32m+[m[32mbreak    → 结束当前分支[m
[32m+[m[32mdefault  → 没有 case 匹配时执行[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m如果省略 `break`，可能发生 fall-through，继续执行后面的 `case`。[m
[32m+[m
