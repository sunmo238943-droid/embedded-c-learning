[32m+[m[32m### 1. 条件判断[m
[32m+[m
[32m+[m[32m学习了 C 语言中的条件判断：[m
[32m+[m
[32m+[m[32m```c[m
[32m+[m[32mif[m
[32m+[m[32melse if[m
[32m+[m[32melse[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m基本结构：[m
[32m+[m
[32m+[m[32m```c[m
[32m+[m[32mif (condition)[m
[32m+[m[32m{[m
[32m+[m[32m    // 条件成立[m
[32m+[m[32m}[m
[32m+[m[32melse[m
[32m+[m[32m{[m
[32m+[m[32m    // 条件不成立[m
[32m+[m[32m}[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m重点区分：[m
[32m+[m
[32m+[m[32m```c[m
[32m+[m[32m=    // 赋值[m
[32m+[m[32m==   // 判断是否相等[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## 2. 比较运算符[m
[32m+[m
[32m+[m[32m```c[m
[32m+[m[32m>[m
[32m+[m[32m<[m
[32m+[m[32m>=[m
[32m+[m[32m<=[m
[32m+[m[32m==[m
[32m+[m[32m!=[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m用于比较两个数据之间的关系。[m
[32m+[m
[32m+[m[32m---[m
[32m+[m
[32m+[m[32m## 3. 逻辑运算符[m
[32m+[m
[32m+[m[32m学习了：[m
[32m+[m
[32m+[m[32m```c[m
[32m+[m[32m&&    // 并且[m
[32m+[m[32m||    // 或者[m
[32m+[m[32m!     // 取反[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m对应 Python：[m
[32m+[m
[32m+[m[32m```text[m
[32m+[m[32m&&  → and[m
[32m+[m[32m||  → or[m
[32m+[m[32m!   → not[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m例如判断电压是否位于正常范围：[m
[32m+[m
[32m+[m[32m```c[m
[32m+[m[32mif (voltage >= 3.0f && voltage <= 5.0f)[m
[32m+[m[32m{[m
[32m+[m[32m    printf("Voltage normal\n");[m
[32m+[m[32m}[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m---[m
